			<Tuotekortti tuote={sc1} otsikko="Kärcher SC 1" sivu={mallisivut['SC 1']} kenelle="Käsimalli pelkkiin saumoihin ja hanoihin" tagi="Edullisin" />
			<Tuotekortti tuote={bath} otsikko="Kärcher SC 5 Bath Edition" sivu={mallisivut['SC 5']} kenelle="Mukana ikkunasuutin ja XXL-rakoharja" tagi="Kylpyhuonepaketti" />
			<Tuotekortti tuote={polti} otsikko="Polti Vaporetto SV440 Double" sivu="/polti-hoyrypesurit/" kenelle="Höyrymoppi, josta irtoaa käsiosa, mukana saumaharja" tagi="Moppi ja käsiosa" />
		</div>
